# Knock Notification Service Configuration
# Get your credentials from: https://dashboard.knock.app/

# Required: Knock API Secret Key (starts with sk_test_ or sk_prod_)
KNOCK_SECRET_KEY=sk_test_your_secret_key_here

# Required: Knock Signing Key (for generating user tokens)
KNOCK_SIGNING_KEY=your_signing_key_here

# Optional: Channel IDs (Get from Knock Dashboard → Channels)
# These are UUIDs that identify specific notification channels
KNOCK_PUSH_CHANNEL_ID=your-push-channel-uuid
KNOCK_IN_APP_CHANNEL_ID=your-in-app-channel-uuid
KNOCK_EMAIL_CHANNEL_ID=your-email-channel-uuid

# Optional: Workflow Keys (Get from Knock Dashboard → Workflows)
# Default workflow for in-app notifications
KNOCK_IN_APP_NOTIFICATION_WORKFLOW_KEY=in-app-notification

# Additional workflow keys can be added as needed
# Example: KNOCK_EMAIL_NOTIFICATION_WORKFLOW_KEY=email-notification
