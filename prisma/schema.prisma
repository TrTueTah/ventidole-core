generator client {
  provider      = "prisma-client"
  output        = "../src/db/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  version             Int                  @default(0)
  isDeleted           Boolean              @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at")
  metadata            Json?
  email               String               @unique(map: "user_email_unique_partial") @db.VarChar(255)
  username            String               @map("username") @db.VarChar(100)
  password            String               @db.VarChar(255)
  role                Role
  deviceToken         String?              @db.VarChar(255)
  avatarUrl           String?              @map("avatar_url") @db.VarChar(255)
  backgroundUrl       String?              @map("background_url") @db.VarChar(255)
  bio                 String?              @db.VarChar(500)
  communityId         String?              @map("communityId")
  isOnline            Boolean              @default(false) @map("is_online")
  isChooseCommunity   Boolean              @default(false) @map("is_choose_community")
  chatParticipants    ChatParticipant[]
  chatMessages        ChatMessage[]
  followedCommunities CommunityFollower[]
  community           Community?           @relation(fields: [communityId], references: [id], onDelete: SetNull)
  chatChannels        ChatChannel[]
  socialAccounts      SocialAccount[]
  verifications       Verification[]
  posts               Post[]               @relation("PostAuthor")
  comments            Comment[]
  postLikes           PostLike[]
  postViews           PostView[]
  postReports         PostReport[]    @relation("PostReporter")
  shops               Shop[]
  carts               Cart[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]
  addresses           Address[]

  @@map("user")
}

model Verification {
  id          String           @id @default(cuid())
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     Int              @default(0)
  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at")
  metadata    Json?
  type        VerificationType
  token       String           @unique
  expiresAt   DateTime         @map("expires_at")
  userId      String?          @map("userId")
  usedAt      DateTime?        @map("used_at")
  confirmedAt DateTime?        @map("confirmed_at")
  email       String?          @db.VarChar(255)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("verification")
}

model SocialAccount {
  id         String                @id @default(cuid())
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  version    Int                   @default(0)
  isDeleted  Boolean               @default(false) @map("is_deleted")
  deletedAt  DateTime?             @map("deleted_at")
  metadata   Json?
  provider   SocialAccountProvider
  providerId String                @map("provider_id")
  userId     String                @map("userId")
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("social_account")
}

model Community {
  id            String              @id @default(cuid())
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  version       Int                 @default(0)
  isDeleted     Boolean             @default(false) @map("is_deleted")
  deletedAt     DateTime?           @map("deleted_at")
  metadata      Json?
  name          String              @db.VarChar(100)
  avatarUrl     String?             @map("avatar_url") @db.VarChar(255)
  backgroundUrl String?             @map("background_url") @db.VarChar(255)
  description   String?             @db.VarChar(500)
  communityType CommunityType       @map("community_type")
  chatChannels  ChatChannel[]
  followers     CommunityFollower[]
  idols         User[]
  posts         Post[]
  shops         Shop[]

  @@map("community")
}

model CommunityFollower {
  id          String    @id @default(cuid())
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  metadata    Json?
  userId      String    @map("userId")
  communityId String    @map("communityId")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("community_follower")
}

model ChatChannel {
  id                  String    @id @default(cuid())
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  version             Int       @default(0)
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  metadata            Json?
  type                String    @default("messaging") @db.VarChar(50)
  name                String?   @db.VarChar(255)
  image               String?   @db.VarChar(500)
  description         String?   @db.VarChar(500)
  communityId         String?   @map("communityId")
  idolId              String?   @map("idolId")
  isCommunityChannel  Boolean   @default(false) @map("is_community_channel")
  memberCount         Int       @default(0) @map("member_count")
  lastMessageAt       DateTime? @map("last_message_at")

  community    Community?        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  idol         User?             @relation(fields: [idolId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([communityId])
  @@index([idolId])
  @@index([lastMessageAt])
  @@index([type])
  @@map("chat_channel")
}

model ChatParticipant {
  id             String      @id @default(cuid())
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  version        Int         @default(0)
  isDeleted      Boolean     @default(false) @map("is_deleted")
  deletedAt      DateTime?   @map("deleted_at")
  metadata       Json?
  channelId      String      @map("channelId")
  userId         String      @map("userId")
  role           String      @default("member") @db.VarChar(50)
  canSendMessage Boolean     @default(true) @map("can_send_message")
  joinedAt       DateTime    @default(now()) @map("joined_at")
  invitedBy      String?     @map("invited_by")
  lastReadAt     DateTime?   @map("last_read_at")
  channel        ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
  @@index([channelId, userId, lastReadAt])
  @@map("chat_participant")
}

model ChatMessage {
  id        String      @id @default(cuid())
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  version   Int         @default(0)
  isDeleted Boolean     @default(false) @map("is_deleted")
  deletedAt DateTime?   @map("deleted_at")
  metadata  Json?
  content   String      @db.Text
  channelId String      @map("channelId")
  userId    String      @map("userId")
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([userId])
  @@index([createdAt])
  @@map("chat_message")
}

model Post {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  content   String
  mediaUrls Json?     @map("media_urls")

  // counters
  likeCount    Int @default(0) @map("like_count")
  commentCount Int @default(0) @map("comment_count")
  viewCount    Int @default(0) @map("view_count")

  // relations
  authorId String @map("authorId")
  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  communityId String    @map("communityId")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  likes    PostLike[]
  comments Comment[]
  views    PostView[]
  reports  PostReport[]

  @@index([authorId])
  @@index([communityId])
  @@map("post")
}

model Comment {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  content   String    @db.VarChar(500)

  // relations
  postId String @map("postId")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("userId")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?   @map("parentId")
  parent   Comment?  @relation("CommentToReply", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentToReply")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comment")
}

model PostLike {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?

  postId String @map("postId")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("userId")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@map("post_like")
}

model PostView {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?

  postId String @map("postId")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("userId")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@map("post_view")
}

model PostReport {
  id         String    @id @default(cuid())
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  version    Int       @default(0)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deletedAt  DateTime? @map("deleted_at")
  metadata   Json?
  reason     String?   @db.Text

  postId     String @map("postId")
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reportedBy String @map("reportedBy")
  reporter   User   @relation("PostReporter", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@unique([postId, reportedBy])
  @@index([reportedBy])
  @@index([postId])
  @@map("post_report")
}

enum Role {
  FAN
  ADMIN
  IDOL
}

enum VerificationType {
  FIND_EMAIL
  RESET_PASSWORD
  REGISTER_ACCOUNT
  UPDATE_PROFILE
  CHANGE_PASSWORD
}

enum SocialAccountProvider {
  GOOGLE
  FACEBOOK
}

enum ChatRole {
  ADMIN
  MEMBER
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAID
  SHIPPING
  DELIVERED
  CANCELED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentMethod {
  CREDIT
  COD
}

enum CommunityType {
  SOLO
  GROUP
}

model Shop {
  id          String    @id @default(cuid())
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  metadata    Json?
  communityId String    @map("community_id")
  name        String    @db.VarChar(255)
  description String?   @db.Text
  avatarUrl   String?   @map("avatar_url") @db.VarChar(255)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  products  Product[]
  User      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([communityId])
  @@map("shop")
}

model ProductType {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  name      String    @db.VarChar(255)

  products Product[]

  @@map("product_type")
}

model Product {
  id          String    @id @default(cuid())
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  metadata    Json?
  shopId      String    @map("shopId")
  name        String    @db.VarChar(255)
  description String?   @db.Text
  note        String?   @db.Text
  price       Float
  stock       Int
  mediaUrls   Json?     @map("media_urls")
  typeId      String?   @map("typeId")

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type       ProductType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([shopId])
  @@index([typeId])
  @@map("product")
}

model ProductVariant {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  name      String    @db.VarChar(255)
  price     Float
  stock     Int
  productId String    @map("product_id")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variant")
}

model Cart {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  userId    String    @map("userId")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@map("cart")
}

model CartItem {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  productId String    @map("productId")
  variantId String?   @map("variantId")
  quantity  Int
  cartId    String    @map("cartId")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_item")
}

model Order {
  id              String        @id @default(cuid())
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  version         Int           @default(0)
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  metadata        Json?
  userId          String        @map("user_id")
  orderCode       String?       @unique @map("order_code") @db.VarChar(50)
  totalAmount     Float         @map("total_amount")
  status          OrderStatus
  shippingAddress Json          @map("shipping_address")
  paymentMethod   PaymentMethod @map("payment_method")
  paidAt          DateTime?     @map("paid_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([status])
  @@index([orderCode])
  @@map("order")
}

model OrderItem {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  orderId   String    @map("orderId")
  productId String    @map("productId")
  variantId String?   @map("variantId")
  price     Float
  quantity  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_item")
}

model PaymentTransaction {
  id            String                   @id @default(cuid())
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  version       Int                      @default(0)
  isDeleted     Boolean                  @default(false) @map("is_deleted")
  deletedAt     DateTime?                @map("deleted_at")
  metadata      Json?
  orderId       String                   @map("orderId")
  userId        String                   @map("userId")
  amount        Float
  provider      String                   @db.VarChar(100)
  orderCode     Int                      @unique @map("order_code")
  paymentLinkId String?                  @map("payment_link_id") @db.VarChar(255)
  providerTxnId String?                  @map("provider_txn_id") @db.VarChar(255)
  status        PaymentTransactionStatus
  paidAt        DateTime?                @map("paid_at")
  checkoutUrl   String?                  @map("checkout_url") @db.Text
  qrCode        String?                  @map("qr_code") @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([orderCode])
  @@map("payment_transaction")
}

model Province {
  id           String    @id @default(cuid())
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(0)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  metadata     Json?
  name         String    @db.VarChar(255)
  code         Int       @unique
  divisionType String    @map("division_type") @db.VarChar(100)
  phoneCode    Int       @map("phone_code")
  codename     String    @db.VarChar(255)

  districts District[]
  addresses Address[]

  @@index([code])
  @@map("province")
}

model District {
  id           String    @id @default(cuid())
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(0)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  metadata     Json?
  name         String    @db.VarChar(255)
  code         Int       @unique
  codename     String    @db.VarChar(255)
  divisionType String    @map("division_type") @db.VarChar(100)
  provinceCode Int       @map("province_code")

  province  Province  @relation(fields: [provinceCode], references: [code], onDelete: Cascade)
  addresses Address[]

  @@index([code])
  @@index([provinceCode])
  @@map("district")
}

model Address {
  id               String    @id @default(cuid())
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Int       @default(0)
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  metadata         Json?
  userId           String    @map("user_id")
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  phoneNumber      String    @map("phone_number") @db.VarChar(20)
  provinceCode     Int       @map("province_code")
  districtCode     Int       @map("district_code")
  detailAddress    String    @map("detail_address") @db.Text
  isDefaultAddress Boolean   @default(false) @map("is_default_address")
  options          Json?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceCode], references: [code], onDelete: Restrict)
  district District @relation(fields: [districtCode], references: [code], onDelete: Restrict)

  @@index([userId])
  @@index([provinceCode])
  @@index([districtCode])
  @@map("address")
}
