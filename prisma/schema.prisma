generator client {
  provider      = "prisma-client"
  output        = "../src/db/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(cuid())
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  version             Int                 @default(0)
  isDeleted           Boolean             @default(false) @map("is_deleted")
  deletedAt           DateTime?           @map("deleted_at")
  metadata            Json?
  email               String              @unique(map: "user_email_unique_partial") @db.VarChar(255)
  username            String              @map("username") @db.VarChar(100)
  password            String              @db.VarChar(255)
  role                Role
  deviceToken         String?             @db.VarChar(255)
  avatarUrl           String?             @map("avatar_url") @db.VarChar(255)
  backgroundUrl       String?             @map("background_url") @db.VarChar(255)
  bio                 String?             @db.VarChar(500)
  communityId         String?             @map("communityId")
  chatParticipants    ChatParticipant[]
  chatMessages        ChatMessage[]
  followedCommunities CommunityFollower[]
  community           Community?          @relation(fields: [communityId], references: [id], onDelete: SetNull)
  chatChannels        ChatChannel[]
  socialAccounts      SocialAccount[]
  verifications       Verification[]
  posts               Post[]              @relation("PostAuthor")
  comments            Comment[]
  postLikes           PostLike[]
  postViews           PostView[]

  @@map("user")
}

model Verification {
  id          String           @id @default(cuid())
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     Int              @default(0)
  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at")
  metadata    Json?
  type        VerificationType
  token       String           @unique
  expiresAt   DateTime         @map("expires_at")
  userId      String?          @map("userId")
  usedAt      DateTime?        @map("used_at")
  confirmedAt DateTime?        @map("confirmed_at")
  email       String?          @db.VarChar(255)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("verification")
}

model SocialAccount {
  id         String                @id @default(cuid())
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  version    Int                   @default(0)
  isDeleted  Boolean               @default(false) @map("is_deleted")
  deletedAt  DateTime?             @map("deleted_at")
  metadata   Json?
  provider   SocialAccountProvider
  providerId String                @map("provider_id")
  userId     String                @map("userId")
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("social_account")
}

model Community {
  id            String              @id @default(cuid())
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  version       Int                 @default(0)
  isDeleted     Boolean             @default(false) @map("is_deleted")
  deletedAt     DateTime?           @map("deleted_at")
  metadata      Json?
  name          String              @db.VarChar(100)
  avatarUrl     String?             @map("avatar_url") @db.VarChar(255)
  backgroundUrl String?             @map("background_url") @db.VarChar(255)
  description   String?             @db.VarChar(500)
  chatChannels  ChatChannel[]
  followers     CommunityFollower[]
  idols         User[]

  @@map("community")
}

model CommunityFollower {
  id          String    @id @default(cuid())
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(0)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  metadata    Json?
  userId      String    @map("userId")
  communityId String    @map("communityId")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("community_follower")
}

model ChatChannel {
  id             String            @id @default(cuid())
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  version        Int               @default(0)
  isDeleted      Boolean           @default(false) @map("is_deleted")
  deletedAt      DateTime?         @map("deleted_at")
  metadata       Json?
  name           String?           @db.VarChar(255)
  description    String?           @db.VarChar(500)
  type           ChatChannelType
  communityId    String?           @map("communityId")
  idolId         String?           @map("idolId")
  isAnnouncement Boolean           @default(false) @map("is_announcement")
  lastMessageAt  DateTime?         @map("last_message_at")
  firebaseDocId  String            @unique @map("firebase_doc_id") @db.VarChar(255)
  community      Community?        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  idol           User?             @relation(fields: [idolId], references: [id], onDelete: Cascade)
  participants   ChatParticipant[]
  messages       ChatMessage[]

  @@index([communityId])
  @@index([idolId])
  @@index([type])
  @@index([lastMessageAt])
  @@map("chat_channel")
}

model ChatParticipant {
  id          String      @id @default(cuid())
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  version     Int         @default(0)
  isDeleted   Boolean     @default(false) @map("is_deleted")
  deletedAt   DateTime?   @map("deleted_at")
  metadata    Json?
  channelId   String      @map("channelId")
  userId      String      @map("userId")
  role        ChatRole    @default(MEMBER)
  lastReadAt  DateTime?   @map("last_read_at")
  unreadCount Int         @default(0) @map("unread_count")
  isMuted     Boolean     @default(false) @map("is_muted")
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
  @@map("chat_participant")
}

model ChatMessage {
  id        String      @id @default(cuid())
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  version   Int         @default(0)
  isDeleted Boolean     @default(false) @map("is_deleted")
  deletedAt DateTime?   @map("deleted_at")
  metadata  Json?
  content   String      @db.Text
  channelId String      @map("channelId")
  userId    String      @map("userId")
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([userId])
  @@index([createdAt])
  @@map("chat_message")
}

model Post {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  content   String
  mediaUrls Json?     @map("media_urls")

  // counters
  likeCount    Int @default(0) @map("like_count")
  commentCount Int @default(0) @map("comment_count")
  viewCount    Int @default(0) @map("view_count")

  // relations
  authorId String     @map("authorId")
  author   User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments Comment[]
  views    PostView[]

  @@index([authorId])
  @@map("post")
}

model Comment {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?
  content   String    @db.VarChar(500)

  // relations
  postId String @map("postId")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("userId")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?   @map("parentId")
  parent   Comment?  @relation("CommentToReply", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentToReply")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comment")
}

model PostLike {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?

  postId String @map("postId")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("userId")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@map("post_like")
}

model PostView {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  metadata  Json?

  postId String @map("postId")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("userId")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@map("post_view")
}

enum Role {
  FAN
  ADMIN
  IDOL
}

enum VerificationType {
  FIND_EMAIL
  RESET_PASSWORD
  REGISTER_ACCOUNT
  UPDATE_PROFILE
}

enum SocialAccountProvider {
  GOOGLE
  FACEBOOK
}

enum ChatChannelType {
  DIRECT
  GROUP
  ANNOUNCEMENT
}

enum ChatRole {
  ADMIN
  MEMBER
}
